# Copy to .env.local for local development (git-ignored). On Vercel, set these in Project → Settings → Environment Variables.

# Same database the fetcher writes to. Local: the private Postgres from scripts/localdb.ps1. Production: Neon.
DATABASE_URL=postgresql://radar@localhost:5433/radar

# Your dashboard password, and a long random string used to sign the login cookie (32+ characters).
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Optional "Run now" button: fine-grained GitHub token with Actions read/write on this repo only.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
