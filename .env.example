# Copy to .env (never commit .env). All services below are free tier.

# Postgres. Local dev: `.\scripts\localdb.ps1 init` (or `docker compose up -d db` if Docker works for you).
# Production: your Neon connection string (keep ?sslmode=require).
DATABASE_URL=postgresql://radar:radar@localhost:5433/radar

# Optional LLM fit scoring (free key from https://console.groq.com). Leave empty for rule-only scoring.
GROQ_API_KEY=
LLM_PROVIDER=groq          # groq | gemini | none
LLM_MAX_CALLS_PER_RUN=40

# Dashboard (Phase 4)
DASHBOARD_PASSWORD=
SESSION_SECRET=            # long random string, used to sign the login cookie

# "Run now" button (Phase 5): fine-grained token with Actions read/write on this repo only
GITHUB_TOKEN=
GITHUB_REPO=               # owner/repo
